# Landing Reply — Frontend environment
# Copy to .env.local and fill in real values.
# Do NOT commit .env.local to Git.

# ── Browser API base ────────────────────────────────────────────────────────
# Used by all client-side fetches (lib/api.ts, StyleGridClient.tsx, etc.)
# Relative path — browser sends to the same host nginx is serving.
# nginx proxies /api/* → backend on that host.
NEXT_PUBLIC_API_URL=/api

# ── Public base URL ─────────────────────────────────────────────────────────
# Used by buildLandingUrl() to construct links sent to clients.
# Must be the canonical public domain.
NEXT_PUBLIC_BASE_URL=https://evflow.ru

# ── SSR / internal API base ─────────────────────────────────────────────────
# Used ONLY by Next.js Node.js server (SSR in r/[slug]/page.tsx, next.config.js rewrite).
# Must be an absolute URL — Node.js cannot resolve relative paths.
# Never exposed to the browser (no NEXT_PUBLIC_ prefix).
INTERNAL_API_URL=http://127.0.0.1:8000
